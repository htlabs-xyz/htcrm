# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.12-slim AS bun-runtime

FROM node:24-trixie-slim AS build

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

ARG API_URL=http://localhost:13001
ARG APP_URL=http://localhost:13000
ENV NODE_ENV=production \
    API_URL=${API_URL} \
    APP_URL=${APP_URL} \
    NEXT_PUBLIC_API_URL=${API_URL} \
    DATABASE_URL=postgresql://postgres:build-only@127.0.0.1:5432/crm?schema=public \
    BETTER_AUTH_SECRET=build-only-secret-not-used-at-runtime-32-chars \
    ALLOWED_SIGN_IN=build.invalid
RUN bun install --frozen-lockfile

RUN bun run --filter=api trpc:generate \
    && bun run --filter=@crm/db build \
    && bun run --filter=api build \
    && bun run --filter=agent build \
    && cd apps/app \
    && node node_modules/next/dist/bin/next build

FROM node:24-trixie-slim AS runtime-base

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app /app

USER node

FROM runtime-base AS migration
CMD ["bun", "run", "--filter=@crm/db", "db:deploy"]

FROM runtime-base AS api
CMD ["bun", "run", "--filter=api", "start:prod"]

FROM runtime-base AS agent
CMD ["bun", "run", "--filter=agent", "start"]

FROM runtime-base AS app
WORKDIR /app/apps/app
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
