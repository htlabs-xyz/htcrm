{
	"name": "@crm/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent-tasks": "./src/agent-tasks.ts",
		"./attribution": "./src/attribution.ts",
		"./blob": "./src/blob.ts",
		"./client": "./src/client.ts",
		"./currency": "./src/currency.ts",
		"./crm-events": "./src/crm-events.ts",
		"./deal-stage": "./src/deal-stage.ts",
		"./enums": "./src/generated/prisma/enums.ts",
		"./favicon": "./src/favicon.ts",
		"./fields": "./src/fields.ts",
		"./fields-shape": "./src/fields-shape.ts",
		"./fx": "./src/fx.ts",
		"./images": "./src/images.ts",
		"./idempotency": "./src/idempotency.ts",
		"./json": "./src/json.ts",
		"./safe-fetch": "./src/safe-fetch.ts",
		"./settings": "./src/settings.ts",
		"./slack-inventory": "./src/slack-inventory.ts",
		"./tracking": "./src/tracking.ts",
		"./workspace": "./src/workspace.ts"
	},
	"scripts": {
		"build": "prisma generate && bun run coordinator:build",
		"check-types": "tsc --noEmit && tsc --noEmit -p coordinator-tsconfig.json",
		"coordinator:build": "wrangler deploy --dry-run --config coordinator-wrangler.jsonc --outdir dist/coordinator",
		"coordinator:deploy": "wrangler deploy --config coordinator-wrangler.jsonc",
		"coordinator:secret": "wrangler secret put D1_COORDINATOR_SECRET --config coordinator-wrangler.jsonc",
		"coordinator:test": "vitest run --config coordinator-vitest.config.ts",
		"db:deploy": "bun scripts/d1-command.ts migrate --remote",
		"db:generate": "prisma generate",
		"db:migrate": "bun scripts/d1-command.ts migrate --local",
		"db:migration:create": "bun scripts/d1-command.ts create",
		"db:push": "bun scripts/d1-command.ts migrate --local",
		"db:reset": "bun scripts/d1-command.ts reset --local",
		"db:seed": "bun scripts/d1-command.ts seed --local",
		"db:seed:remote": "bun scripts/d1-command.ts seed --remote",
		"db:studio": "bun scripts/d1-command.ts studio --local",
		"db:test": "bun scripts/test-db.ts",
		"dev": "bun scripts/coordinator-dev.mjs",
		"test": "bun test test/*.spec.ts && bun run coordinator:test",
		"dev:prepare": "bun scripts/prepare-dev.ts",
		"lint": "biome check .",
		"postinstall": "prisma generate",
		"clean": "rm -rf .turbo dist node_modules src/generated"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@prisma/adapter-d1": "^7.9.1",
		"@prisma/adapter-libsql": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@vercel/blob": "^2.6.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^5.20260823.1",
		"@crm/typescript-config": "workspace:*",
		"@types/node": "^24.10.1",
		"prisma": "^7.9.1",
		"typescript": "5.9.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	}
}
